class Solution {
public:
    bool containsNearbyDuplicate(vector<int>& nums, int k) {
        unordered_set<int> s;

        for (int i = 0; i < nums.size(); i++) {
            // Check if element exists in current window
            if (s.find(nums[i]) != s.end()) {
                return true;
            }

            s.insert(nums[i]);

            // Keep the set size at most k (sliding window)
            if (s.size() > k) {
                s.erase(nums[i - k]);
            }
        }

        return false;
    }
};
