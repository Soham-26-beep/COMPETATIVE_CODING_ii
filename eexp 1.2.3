#include <iostream>
#include <stack>

using namespace std;

class MyQueue {
private:
    stack<int> input;
    stack<int> output;

    // Helper method to move elements from input to output stack when needed
    void transfer() {
        if (output.empty()) {
            while (!input.empty()) {
                output.push(input.top());
                input.pop();
            }
        }
    }

public:
    MyQueue() {}

    void push(int x) {
        input.push(x);
    }

    int pop() {
        transfer();
        int val = output.top();
        output.pop();
        return val;
    }

    int peek() {
        transfer();
        return output.top();
    }

    bool empty() {
        return input.empty() && output.empty();
    }
};

// Driver code for standalone execution
int main() {
    MyQueue myQueue;
    myQueue.push(1);
    myQueue.push(2);

    cout << "Peek top element: " << myQueue.peek() << endl; // Returns 1
    cout << "Pop element: " << myQueue.pop() << endl;       // Returns 1
    cout << "Is empty? " << (myQueue.empty() ? "true" : "false") << endl; // Returns false

    return 0;
}
